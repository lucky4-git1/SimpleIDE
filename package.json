{
  "name": "ide",
  "private": true,
  "version": "0.0.0",
  "description": "A lightweight and aesthetic desktop IDE.",
  "author": "Lucky",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs=require('fs'); ['dist-release', 'dist-electron', 'dist-release-new'].forEach(d => { try { fs.rmSync(d, {recursive:true, force:true}); } catch(e) { if(e.code==='EPERM') console.error('PERMISSION ERROR: Could not delete ' + d + '. Please close any running instances of the app or open folders in Explorer.'); else throw e; } })\"",
    "make-icon": "node scripts/convert-icon.js",
    "build": "vite build",
    "package": "npm run clean && npm run make-icon && vite build && electron-builder",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-popover": "^1.1.20",
    "@radix-ui/react-scroll-area": "^1.2.15",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-toast": "^1.2.20",
    "@radix-ui/react-tooltip": "^1.2.13",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.14.0",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "simple-git": "^3.36.0",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.20.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "^41.10.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "vite": "^8.1.5",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "build": {
    "appId": "com.lucky.ide",
    "productName": "Simple IDE",
    "directories": {
      "output": "dist-release-new"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "allowScripts": {
    "ci-info@4.4.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.0": true,
    "simple-update-notifier@2.0.0": true,
    "yargs@17.7.2": true,
    "zod-validation-error@4.0.2": true,
    "@humanfs/node@0.16.8": true,
    "@humanwhocodes/module-importer@1.0.1": true,
    "@monaco-editor/loader@1.7.0": true
  }
}
